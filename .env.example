# TMDB API key used by the FastAPI backend (server/).
#
# Either value works:
#   * the 32-character "API Key" from https://www.themoviedb.org/settings/api
#   * the longer "API Read Access Token" (a JWT) from the same page
#
# This key stays on the server and is never sent to the browser. Do not commit
# the real value; .env is gitignored.
TMDB_API_KEY=your_tmdb_api_key_here
